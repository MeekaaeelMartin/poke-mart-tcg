generator client {
  provider      = "prisma-client-js"
  // Hostinger Linux runtimes — include common OpenSSL targets so engines exist at runtime
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  name             String?
  passwordHash     String
  image            String?
  isPremium        Boolean        @default(false)
  premiumUntil     DateTime?
  username         String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  portfolioItems   PortfolioItem[]
  watchlistItems   WatchlistItem[]
  activities       Activity[]
  alerts           PriceAlert[]
}

model Card {
  id              String   @id
  setId           String
  name            String
  number          String?
  supertype       String?
  subtypes        String? // JSON array
  hp              Int?
  types           String? // JSON array
  rarity          String?
  artist          String?
  imageSmall      String?
  imageLarge      String?
  imageThumb      String?
  setName         String?
  setCode         String?
  // Prices stored in ZAR after conversion
  priceZar        Float?
  priceEur        Float?
  avg7dZar        Float?
  avg30dZar       Float?
  pctChange1d     Float?
  pctChange7d     Float?
  pctChange30d    Float?
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  set             Set?     @relation(fields: [setId], references: [id])
  portfolioItems  PortfolioItem[]
  watchlistItems  WatchlistItem[]
  alerts          PriceAlert[]

  @@index([name])
  @@index([setId])
  @@index([rarity])
  @@index([priceZar])
}

model Set {
  id             String   @id
  name           String
  series         String?
  releaseDate    String?
  officialCards  Int?
  totalCards     Int?
  logoUrl        String?
  symbolUrl      String?
  setCode        String?
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cards          Card[]

  @@index([series])
  @@index([name])
}

model PortfolioItem {
  id         String   @id @default(cuid())
  userId     String
  cardId     String
  quantity   Int      @default(1)
  condition  String   @default("Raw")
  purchasePrice Float?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card       Card     @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId, condition])
  @@index([userId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  cardId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      Card     @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId])
  @@index([userId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PriceAlert {
  id           String   @id @default(cuid())
  userId       String
  cardId       String
  targetPrice  Float
  direction    String   @default("below") // below | above
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card         Card     @relation(fields: [cardId], references: [id])

  @@index([userId])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  category    String
  author      String
  authorRole  String?
  authorImage String?
  imageUrl    String?
  readMinutes Int      @default(5)
  featured    Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSub {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model SyncLog {
  id           String   @id @default(cuid())
  type         String
  status       String
  cardsUpdated Int      @default(0)
  setsUpdated  Int      @default(0)
  message      String?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
}
