# Database (SQLite file — created automatically)
DATABASE_URL="file:./dev.db"

# ============================================================
# CARDDEX API KEY — PUT YOUR KEY HERE
# Get one free at https://carddex.dev/
# Used by the nightly 3:00 AM sync (server-side only — never expose to the browser)
# ============================================================
CARDDEX_API_KEY="pk_live_YOUR_KEY_HERE"
CARDDEX_BASE_URL="https://api.carddex.dev"

# EUR → ZAR conversion rate used when storing prices locally
EUR_TO_ZAR=20.5

# Auth secret (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: protect the cron endpoint in production
CRON_SECRET="poke-mart-cron-secret"

# Premium price (display only)
PREMIUM_PRICE_ZAR=50
