# Database — use a relative path; the app resolves it to an absolute path at runtime
DATABASE_URL="file:./prisma/prod.db"

# ============================================================
# CARDDEX API KEY — PUT YOUR KEY HERE (Hostinger env too)
# ============================================================
CARDDEX_API_KEY="pk_live_YOUR_KEY_HERE"
CARDDEX_BASE_URL="https://api.carddex.dev"

EUR_TO_ZAR=20.5

# Auth — required in production on Hostinger
AUTH_SECRET="change-me-to-a-long-random-secret"
AUTH_TRUST_HOST="true"
# Must be your live site URL on Hostinger, e.g.:
# NEXTAUTH_URL="https://white-mouse-613181.hostingersite.com"
NEXTAUTH_URL="http://localhost:3000"

CRON_SECRET="poke-mart-cron-secret"
PREMIUM_PRICE_ZAR=50
